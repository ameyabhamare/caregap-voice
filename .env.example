# Copy to .env. Every default runs fully local at zero cost.

# --- Postgres (app data, cost ledger, pgvector; MLflow uses database "mlflow") ---
POSTGRES_USER=caregap
POSTGRES_PASSWORD=caregap
POSTGRES_DB=caregap
POSTGRES_PORT=5432
DATABASE_URL=postgresql://caregap:caregap@localhost:5432/caregap

# --- LLM runtime ---
# ollama (default, free) | claude (paid, only for final evals and demo recordings)
LLM_PROVIDER=ollama
# Hard cap on total paid spend in USD across all runs. Paid calls are refused once reached.
LLM_BUDGET_USD=5.00
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Only needed when LLM_PROVIDER=claude. Never commit a real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 always thinks; effort sets how much)
CLAUDE_EFFORT=medium

# --- MLflow ---
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
# Silence MLflow's coding-agent hint in logs.
MLFLOW_DISABLE_AGENT_HINT=1

# --- HAPI FHIR ---
FHIR_PORT=8080
FHIR_BASE_URL=http://localhost:8080/fhir

# --- Databricks (optional; only for make pipeline-databricks) ---
# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token. Never commit a real one. (Or use a CLI profile instead.)
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=caregap

# --- Voice ---
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_PRONUNCIATION_OVERRIDES=true
STT_MODEL=small.en

# --- Campaigns and telephony (Phase 5) ---
# Demo clock: the core service starts its clock here and lets it run, so a campaign falls
# inside the call window whatever the real time is. Leave empty to use real time.
CAMPAIGN_CLOCK=2026-01-13T10:00:00-05:00
CAMPAIGN_TIMEZONE=America/New_York
CORE_PORT=8000
N8N_PORT=5678
TWILIO_MOCK_PORT=8100
# The local mock by default. Phase 11 points these at a real Twilio trial account.
TWILIO_API_BASE_URL=http://twilio-mock:8100
TWILIO_ACCOUNT_SID=ACmock0000000000000000000000000000
TWILIO_AUTH_TOKEN=mock-auth-token
TWILIO_FROM_NUMBER=+15550100000
# Seconds the mock waits before calling back.
MOCK_CALL_DELAY_S=1.0
# Slack-compatible incoming webhook ({"text": ...}) for alerts and escalations.
# Default: the core service's own sink, which appends to data/notifications.log.
NOTIFY_WEBHOOK_URL=http://core:8000/notifications
# Extra CA bundle for image builds behind a TLS-inspecting proxy (path inside the repo).
BUILD_EXTRA_CA_CERT=
