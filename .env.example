# Copy to .env. Every default runs fully local at zero cost.

# --- Postgres (app data, cost ledger, pgvector; MLflow uses database "mlflow") ---
POSTGRES_USER=caregap
POSTGRES_PASSWORD=caregap
POSTGRES_DB=caregap
POSTGRES_PORT=5432
DATABASE_URL=postgresql://caregap:caregap@localhost:5432/caregap

# --- LLM runtime ---
# ollama (default, free) | claude (paid, only for final evals and demo recordings)
LLM_PROVIDER=ollama
# Hard cap on total paid spend in USD across all runs. Paid calls are refused once reached.
LLM_BUDGET_USD=5.00
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Only needed when LLM_PROVIDER=claude. Never commit a real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 always thinks; effort sets how much)
CLAUDE_EFFORT=medium

# --- MLflow ---
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# --- HAPI FHIR ---
FHIR_PORT=8080
FHIR_BASE_URL=http://localhost:8080/fhir

# --- Databricks (optional; only for make pipeline-databricks) ---
# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token. Never commit a real one. (Or use a CLI profile instead.)
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=caregap
